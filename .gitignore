# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# data-fetch scrape cache + python venv
/scripts/cache/
/data/cache/
.nse-venv/
.screen-venv/

# python
__pycache__/
*.py[cod]

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Intermediate staging file for the universe expansion (regenerate with
# scripts/fetch_new_stocks.py) - 3MB and not needed to build the app.
data/_new_pool.json
